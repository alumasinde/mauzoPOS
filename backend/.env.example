# Copy to .env for local development. In production these come from the environment
# (Docker / secrets manager); .env is only loaded when APP_ENV=development.

APP_ENV=development
APP_NAME=MauzoPOS
HTTP_ADDR=:8080
LOG_LEVEL=debug
PUBLIC_BASE_URL=http://localhost:8080

# Comma-separated origins allowed for the browser apps
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# MariaDB / MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mauzo
DB_USER=mauzo
DB_PASSWORD=change-me
DB_PARAMS=parseTime=true&loc=UTC&charset=utf8mb4&collation=utf8mb4_unicode_ci&multiStatements=false
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
TEST_DB_NAME=mauzo_test

# Redis (optional in dev; leave empty to use in-memory fallbacks)
REDIS_URL=

# Security — generate with: openssl rand -base64 32
SESSION_TOKEN_TTL=12h
ENCRYPTION_KEY=           # AES-256 key for tenant secrets (Daraja, eTIMS); base64, 32 bytes
WEBHOOK_PATH_SECRET=      # random path segment for provider callbacks

# Argon2id parameters
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

# Storage (local disk in dev; s3-compatible later)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# Mail (password recovery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@localhost

# M-Pesa Daraja (platform defaults; tenant credentials are stored encrypted in DB)
MPESA_ENV=sandbox
MPESA_CALLBACK_BASE_URL=   # public HTTPS URL (e.g. a tunnel) for local callback testing

# KRA eTIMS
ETIMS_ENV=sandbox
ETIMS_BASE_URL=

# Phase 1 — auth
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT=15m
PLATFORM_APP_URL=http://localhost:5174
WEB_APP_URL=http://localhost:5173
