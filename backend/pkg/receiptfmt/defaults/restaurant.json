{
  "version": 1,
  "paper": 80,
  "blocks": [
    { "type": "logo", "if": "has.logo" },
    { "type": "text", "text": "{{business.name}}", "align": "center", "bold": true, "size": "double" },
    { "type": "text", "text": "{{branch.location}}\nTel: {{branch.phone}}", "align": "center" },
    { "type": "text", "if": "business.kra_pin", "text": "PIN: {{business.kra_pin}}", "align": "center" },
    { "type": "divider", "char": "=" },
    { "type": "text", "text": "TAX INVOICE", "align": "center", "bold": true },
    {
      "type": "fields",
      "fields": [
        { "label": "Invoice", "value": "{{sale.receipt_no}}" },
        { "label": "Date", "value": "{{sale.datetime}}" },
        { "label": "Served by", "value": "{{sale.cashier}}" },
        { "label": "Customer", "value": "{{sale.customer}}" },
        { "label": "Customer PIN", "value": "{{sale.customer_pin}}" }
      ]
    },
    { "type": "divider" },
    { "type": "items", "layout": "detailed" },
    { "type": "divider" },
    { "type": "totals" },
    { "type": "divider" },
    { "type": "payments" },
    { "type": "divider" },
    { "type": "tax_summary" },
    { "type": "divider", "char": "=" },
    { "type": "fiscal" },
    { "type": "divider", "char": "=" },
    { "type": "text", "if": "footer", "text": "{{footer}}", "align": "center" },
    { "type": "text", "text": "Thank you for dining with us!", "align": "center", "bold": true }
  ]
}
